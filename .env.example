# Copy to .env and fill in. Never commit .env.

# Free key from https://openrouter.ai/keys (the default model is free)
OPENROUTER_API_KEY=

# Slack bot token (xoxb-...). Scopes: channels:read, channels:history, groups:read, groups:history
# Not needed for --demo.
SLACK_BOT_TOKEN=

# Optional: a different OpenRouter model
# BRIEFING_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free

# Optional: path to your Google OAuth client file (default: credentials.json here)
# GOOGLE_CREDENTIALS_FILE=credentials.json
